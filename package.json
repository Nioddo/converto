{
  "name": "converto",
  "version": "1.0.8",
  "private": true,
  "description": "Convierte YouTube y Spotify a MP3 320/FLAC sin metadatos ni caratulas, para reproductores MP3 basicos",
  "author": "Nioddo",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/generate-icon.js",
    "dist": "npm run icon && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@deno/win32-x64": "^2.9.6",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.converto.app",
    "productName": "Converto",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Nioddo",
      "repo": "converto"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@deno/win32-x64/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Converto"
    }
  }
}
