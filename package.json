{
  "name": "converto",
  "version": "1.0.0",
  "private": true,
  "description": "Convierte YouTube y Spotify a MP3 320/FLAC sin metadatos ni caratulas, para reproductores MP3 basicos",
  "author": "Nioddo",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.converto.app",
    "productName": "Converto",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Converto"
    }
  }
}
